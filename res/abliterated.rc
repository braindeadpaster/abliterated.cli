#include "resource.h"

// App icon. Multi-size .ico (256/128/64/48/32/16, PNG payloads) so Explorer,
// Alt-Tab, and the taskbar all get a crisp copy at the size they need.
IDI_APP ICON "..\\assets\\icon.ico"

// The jailbreak, embedded as RCDATA. session.cpp extracts it to
// %LOCALAPPDATA%\abliterated.cli\jb.md at launch when no on-disk copy
// exists next to the exe (so dev builds editing assets\jb.md still win).
IDR_JB_MD RCDATA "..\\assets\\jb.md"
